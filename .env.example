# 先執行 python scripts/configure.py 產生 .env；範例內容不可直接用於正式環境。
CARBON_SECRET=replace-with-at-least-32-random-characters
CARBON_DATA_DIR=./data
# 本機 HTTP 為 false；正式 HTTPS 請改 true。
CARBON_SECURE_COOKIE=false

# 雲端 PostgreSQL（未設定時仍使用本機 SQLite）
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# 只用於建立首位管理員，建立成功後可從雲端環境移除以下兩項。
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
